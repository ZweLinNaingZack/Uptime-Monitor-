# Copy this file to `.env` and adjust. `.env` is git-ignored; this example is committed.

# SQLAlchemy database URL. A relative SQLite path is relative to where you start uvicorn.
DATABASE_URL=sqlite:///./uptime.db

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# LOCAL DEVELOPMENT ONLY. 1 = allow monitoring private/loopback addresses such as
# http://127.0.0.1:8001. This disables the SSRF protection. Never set it on a server
# other people can reach.
ALLOW_PRIVATE_URLS=0
